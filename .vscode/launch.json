{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Debug ESP32-C3 (Debug Build)",
      "cwd": "${workspaceFolder}",
      "chip": "esp32c3",
      "flashingConfig": {
        "flashingEnabled": true,
        "resetAfterFlashing": true,
        "haltAfterReset": true
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/riscv32imc-unknown-none-elf/debug/waveshare-esp32-sandbox-1"
        }
      ]
    },
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "Debug ESP32-C3 (Release Build)",
      "cwd": "${workspaceFolder}",
      "chip": "esp32c3",
      "flashingConfig": {
        "flashingEnabled": true,
        "resetAfterFlashing": true,
        "haltAfterReset": true
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/riscv32imc-unknown-none-elf/release/waveshare-esp32-sandbox-1"
        }
      ]
    },
    {
      "type": "probe-rs-debug",
      "request": "attach",
      "name": "Attach to ESP32-C3 (No Flash)",
      "cwd": "${workspaceFolder}",
      "chip": "esp32c3",
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/riscv32imc-unknown-none-elf/debug/waveshare-esp32-sandbox-1"
        }
      ]
    }
  ]
}
